# Copy to .env locally and fill in only the provider(s) you actually use.
# Never commit real credentials.

# Provider choice: auto (default), meta, or baseten.
# auto prefers Baseten when BASETEN_API_KEY is set, else Meta.
HTW_PROVIDER=auto

# Primary Meta Model API key (official variable per Meta docs).
MODEL_API_KEY=
# Backwards-compatible fallback; MODEL_API_KEY takes precedence.
META_MODEL_API_KEY=
# Optional overrides (defaults shown).
META_MODEL_ID=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1

# Baseten hackathon key for the Muse Spark Open route.
BASETEN_API_KEY=

# Optional server overrides (defaults: 127.0.0.1 and 8000).
HTW_HOST=127.0.0.1
PORT=8000
